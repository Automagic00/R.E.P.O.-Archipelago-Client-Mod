<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- COPY THIS FILE AS 'RepoAP.csproj.user' AND EDIT THESE SETTINGS -->
  <PropertyGroup>
    <!-- Set this to the folder that contains 'REPO.exe' -->
    <!-- ex: C:\Program Files (x86)\Steam\steamapps\common\REPO -->
    <REPO>C:\Program Files (x86)\Steam\steamapps\common\REPO</REPO>

    <!-- Set this to the location you want the mod files copied to for testing (usually a profile in a mod manager) -->
    <!-- ex: D:\Software\com.kesomannen.gale\repo\profiles\ArchipelaREPO - Test Branch\BepInEx\plugins\Automagic-Archipelago_Randomizer_for_REPO -->
    <!-- Leave blank if you don't want new release builds to be copied automatically -->
    <OutputFolder></OutputFolder>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Do Not Modify -->
    <GameManagedFolder>$(REPO)\REPO_Data\Managed</GameManagedFolder>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebuggerFlavor>ProjectDebugger</DebuggerFlavor>
  </PropertyGroup>
  <PropertyGroup>
    <ActiveDebugProfile>REPO Run</ActiveDebugProfile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebuggerFlavor>ProjectDebugger</DebuggerFlavor>
  </PropertyGroup>

  <!-- Copies mod files to a profile for testing. Will do nothing if OutputFolder is left blank. -->
  <Target Name="MoveDllToMods" AfterTargets="Build" Condition="Exists('$(TargetDir)$(TargetName).dll') And Exists('$(OutputFolder)/')">
    <Message Text="Copying $(ProjectName).dll to $(OutputFolder) Folder..." Importance="high" />
    <Delete Condition="Exists('$(OutputFolder)\$(ProjectName).dll')" Files="$(OutputFolder)\$(ProjectName).dll" />
    <Delete Condition="Exists('$(OutputFolder)\Archipelago.MultiClient.Net.dll')" Files="$(OutputFolder)\Archipelago.MultiClient.Net.dll" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFiles="$(OutputFolder)\$(ProjectName).dll" />
    <Copy SourceFiles="$(PkgArchipelago_MultiClient_Net)\lib\net45\Archipelago.MultiClient.Net.dll" DestinationFiles="$(OutputFolder)\Archipelago.MultiClient.Net.dll" />
  </Target>
  
</Project>