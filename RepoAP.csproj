<Project Sdk="Microsoft.NET.Sdk">
  
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<AssemblyName>RepoAP</AssemblyName>
		<Product>Archipelago Randomizer</Product>
		<Version>0.4.5</Version>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
		<RestoreAdditionalProjectSources>
			https://api.nuget.org/v3/index.json;
			https://nuget.bepinex.dev/v3/index.json;
			https://nuget.samboy.dev/v3/index.json;
			https://nuget.windows10ce.com/nuget/v3/index.json
		</RestoreAdditionalProjectSources>
		<RootNamespace>RepoAP</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn); MSB3277</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Archipelago.MultiClient.Net" Version="6.6.0" >
			<GeneratePathProperty>True</GeneratePathProperty>
		</PackageReference>
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Core" Version="5.*" />
		<PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
		<PackageReference Include="System.ValueTuple" Version="4.6.1" />
		<PackageReference Include="UnityEngine.Modules" Version="6000.3.17" IncludeAssets="compile" PrivateAssets="all" />
	</ItemGroup>
  
	<ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp"           HintPath="$(GameManagedFolder)\Assembly-CSharp.dll"           PrivateAssets="all" Publicize="true" />
		<Reference Include="Assembly-CSharp-firstpass" HintPath="$(GameManagedFolder)\Assembly-CSharp-firstpass.dll" PrivateAssets="all" Publicize="true" />
		<Reference Include="Photon3Unity3D"            HintPath="$(GameManagedFolder)\Photon3Unity3D.dll"            PrivateAssets="all" />
		<Reference Include="PhotonRealtime"            HintPath="$(GameManagedFolder)\PhotonRealtime.dll"            PrivateAssets="all" />
		<Reference Include="PhotonUnityNetworking"     HintPath="$(GameManagedFolder)\PhotonUnityNetworking.dll"     PrivateAssets="all" />
		<Reference Include="Unity.TextMeshPro"         HintPath="$(GameManagedFolder)\Unity.TextMeshPro.dll"         PrivateAssets="all" />
		<Reference Include="Unity.Localization"        HintPath="$(GameManagedFolder)\Unity.Localization.dll"        PrivateAssets="all" />
		<Reference Include="Unity.Addressables"        HintPath="$(GameManagedFolder)\Unity.Addressables.dll"        PrivateAssets="all" />
		<Reference Include="Unity.ResourceManager"     HintPath="$(GameManagedFolder)\Unity.ResourceManager.dll"     PrivateAssets="all" />
		<Reference Include="UnityEngine.UI"            HintPath="$(GameManagedFolder)\UnityEngine.UI.dll"            PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="REPOModding-MenuLib" Version="2.6.*" />
		<PackageReference Include="Zehs-REPOLib" Version="4.*" />
	</ItemGroup>
  
</Project>
